TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MUDREX_SYMBOLS=BTCUSDT,ETHUSDT
SCAN_INTERVAL_SECONDS=30
ALERT_COOLDOWN_MINUTES=15
MIN_RR=1.85

# Always-on Delta signal engine (signal-only; no private trading credentials)
DELTA_AUTO_SIGNAL_ENGINE=true
DELTA_SIGNAL_SCAN_SECONDS=60
DELTA_CANDLE_LIMIT=180
DELTA_MIN_SCORE=72
DELTA_STRONG_SCORE=86
DELTA_AI_CONFIRMATION=true
DELTA_AI_MIN_SCORE=72
DELTA_SIGNAL_COOLDOWN_MINUTES=5
DELTA_STATS_PATH=data/delta_signal_stats.json
DELTA_REST_BASE=https://api.india.delta.exchange
DELTA_PUBLIC_WS_URL=wss://public-socket.india.delta.exchange
DELTA_SYMBOLS=BTCUSD,ETHUSD,XAUTUSD
# V14 research module requires no new API keys. It uses existing Delta public data + DATABASE_URL.

# --- LIVE TRADING (default OFF) ---
# Use a TRADING-scoped Delta API key. Telegram CONFIRM still required per order.
LIVE_TRADING_ENABLED=false
DELTA_API_KEY=
DELTA_API_SECRET=
LIVE_MAX_CONTRACTS=5
LIVE_MAX_ORDER_USD=500
LIVE_MAX_OPEN=2
LIVE_MAX_DAILY_LOSS_USD=150
LIVE_MAX_SLIPPAGE_PCT=2.5
LIVE_ALLOCATION_PCT=0.08
LIVE_MIN_SCORE=66
